{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-research-lab.local/schemas/canonical_event_v1.json",
  "title": "CanonicalMarketEvent v1",
  "description": "Canonical prediction-market event envelope and variant payloads.",
  "oneOf": [
    {
      "$ref": "#/$defs/trade"
    },
    {
      "$ref": "#/$defs/book_snapshot"
    },
    {
      "$ref": "#/$defs/ohlcv"
    },
    {
      "$ref": "#/$defs/book_delta"
    },
    {
      "$ref": "#/$defs/metadata_update"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "venue_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "trade",
            "book_snapshot",
            "ohlcv",
            "book_delta",
            "metadata_update"
          ]
        },
        "ts_event": {
          "type": "string",
          "format": "date-time"
        },
        "ts_record": {
          "type": "string",
          "format": "date-time"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "sequence_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ts_exchange": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ts_receive": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0
        }
      },
      "required": [
        "event_id",
        "instrument_id",
        "venue_id",
        "event_type",
        "ts_event",
        "ts_record",
        "schema_version"
      ]
    },
    "price_level": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "size": {
          "type": "number",
          "minimum": 0.0
        }
      },
      "required": [
        "price",
        "size"
      ],
      "additionalProperties": false
    },
    "trade": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "trade"
            },
            "price": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0.0
            },
            "side": {
              "type": "string",
              "enum": [
                "buy",
                "sell"
              ]
            },
            "trade_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "price",
            "size",
            "side",
            "trade_id"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "book_snapshot": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "book_snapshot"
            },
            "bids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/price_level"
              }
            },
            "asks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/price_level"
              }
            }
          },
          "required": [
            "bids",
            "asks"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "ohlcv": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "ohlcv"
            },
            "open": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "high": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "low": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "close": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "volume": {
              "type": "number",
              "minimum": 0.0
            },
            "resolution": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "1h",
                "1d"
              ]
            }
          },
          "required": [
            "open",
            "high",
            "low",
            "close",
            "volume",
            "resolution"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "book_delta": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "book_delta"
            },
            "side": {
              "type": "string",
              "enum": [
                "bid",
                "ask"
              ]
            },
            "price": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "delta_size": {
              "type": "number"
            },
            "reason": {
              "type": "string",
              "enum": [
                "add",
                "cancel",
                "trade"
              ]
            }
          },
          "required": [
            "side",
            "price",
            "delta_size",
            "reason"
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "metadata_update": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "const": "metadata_update"
            },
            "fields_changed": {
              "type": "object"
            }
          },
          "required": [
            "fields_changed"
          ],
          "unevaluatedProperties": false
        }
      ]
    }
  }
}
