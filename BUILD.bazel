package(default_visibility = ["//visibility:private"])

exports_files([
    ".bazelrc",
    ".bazelversion",
    ".envrc",
    ".pre-commit-config.yaml",
    ".python-version",
    "CODEOWNERS",
    "Institutional_Multi_Asset_Quant_Monorepo_Blueprint.pdf",
    "Makefile",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "flake.lock",
    "flake.nix",
    "pyproject.toml",
    "requirements.bazel.txt",
    "uv.lock",
])

filegroup(
    name = "repository_governance_data",
    srcs = glob([
        ".github/**/*.md",
        ".github/**/*.yml",
        ".vscode/**/*.json",
        "docs/**",
        "environments/dev/**",
        "secrets/.secrets.example",
    ]) + [
        ".bazelrc",
        ".bazelversion",
        ".envrc",
        ".pre-commit-config.yaml",
        ".python-version",
        "CODEOWNERS",
        "Institutional_Multi_Asset_Quant_Monorepo_Blueprint.pdf",
        "Makefile",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "flake.lock",
        "flake.nix",
        "pyproject.toml",
        "requirements.bazel.txt",
        "uv.lock",
        "//tools/governance:pyproject.toml",
    ],
    visibility = ["//tests/build:__pkg__"],
)

filegroup(
    name = "docs_bundle",
    srcs = glob(["docs/**"]),
)

filegroup(
    name = "ci_policy_data",
    srcs = [
        "docs/architecture/ci-policy.toml",
        "docs/architecture/ci-tool-dependencies.toml",
        "docs/governance/change-risk-policy.toml",
        "docs/governance/evidence/examples/b05-r2-partial/manifest.toml",
        "uv.lock",
    ] + glob(["docs/governance/evidence/examples/b05-r2-partial/reports/**"]),
    visibility = ["//tests/engineering:__pkg__"],
)

filegroup(
    name = "dependency_admission_data",
    srcs = [
        ".github/workflows/ci.yml",
        ".pre-commit-config.yaml",
        "MODULE.bazel.lock",
        "Makefile",
        "docs/architecture/build-tool-dependencies.toml",
        "docs/architecture/ci-tool-dependencies.toml",
        "docs/architecture/dependency-admission.toml",
        "docs/architecture/engineering-tool-dependencies.toml",
        "docs/architecture/remote-execution.toml",
        "docs/governance/change-risk-policy.toml",
        "docs/governance/evidence/examples/b07-r2-partial/manifest.toml",
        "environments/dev/toolchain.toml",
        "flake.lock",
        "pyproject.toml",
        "requirements.bazel.txt",
        "uv.lock",
        "//tools/governance:pyproject.toml",
    ] + glob(["docs/governance/evidence/examples/b07-r2-partial/reports/**"]),
    visibility = ["//tests/engineering:__pkg__"],
)

filegroup(
    name = "engineering_standards_data",
    srcs = [
        "docs/architecture/engineering-standards.toml",
        "docs/architecture/engineering-tool-dependencies.toml",
        "uv.lock",
    ],
    visibility = ["//tests/engineering:__pkg__"],
)

filegroup(
    name = "remote_execution_policy_data",
    srcs = [
        ".bazelrc",
        ".github/workflows/ci.yml",
        ".pre-commit-config.yaml",
        "Makefile",
        "docs/architecture/remote-execution.toml",
        "docs/governance/change-risk-policy.toml",
        "docs/governance/evidence/examples/b06-r2-partial/manifest.toml",
    ] + glob(["docs/governance/evidence/examples/b06-r2-partial/reports/**"]),
    visibility = ["//tests/engineering:__pkg__"],
)

alias(
    name = "platform_library",
    actual = "//src/alpha_research:alpha_research",
)

test_suite(
    name = "hermetic_build_tests",
    tests = [
        "//tests/build:build_graph_test",
        "//tests/build:sandbox_test",
        "//tests/build/fixtures/proto:buf_toolchain_test",
        "//tests/build/fixtures/sql:generated_sql_test",
        "//tests/build/fixtures/sql:invalid_substitution_test",
        "//tests/engineering:ci_runner_test",
        "//tests/engineering:engineering_standards_test",
        "//tests/engineering:dependency_admission_test",
        "//tests/engineering:remote_execution_test",
    ],
)

test_suite(
    name = "developer_environment_tests",
    tests = ["//tests/build:developer_environment_test"],
)
