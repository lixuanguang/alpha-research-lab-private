common --enable_bzlmod
common --lockfile_mode=error

build --incompatible_strict_action_env
build --incompatible_default_to_explicit_init_py
build --experimental_convenience_symlinks=ignore
build --spawn_strategy=sandboxed
build --strategy=Genrule=sandboxed

test --test_output=errors
test --test_env=LC_ALL=C.UTF-8
test --test_env=TZ=UTC

build:ci --announce_rc
build:ci --color=no
build:ci --curses=no
build:ci --show_progress_rate_limit=5

# Authenticated remote execution. Credentials are injected by the governed runner.
build:remote-execution --remote_cache=grpcs://remote.buildbuddy.io
build:remote-execution --remote_executor=grpcs://remote.buildbuddy.io
build:remote-execution --spawn_strategy=remote
build:remote-execution --strategy=Genrule=remote
build:remote-execution --remote_instance_name=alpha-research-lab-private/trusted/bazel-9.1.0-python-3.12.14-linux-x86_64-v1
build:remote-execution --remote_upload_local_results
build:remote-execution --remote_verify_downloads
build:remote-execution --guard_against_concurrent_changes=full
build:remote-execution --remote_local_fallback=false
build:remote-execution --remote_retries=2
build:remote-execution --remote_retry_max_delay=3s
build:remote-execution --remote_timeout=60s
build:remote-execution --remote_download_toplevel
build:remote-execution --jobs=25
test:remote-execution --flaky_test_attempts=1
test:remote-execution --runs_per_test=1
test:remote-execution --test_env=PYTHONHASHSEED=20260902
test:remote-execution --test_env=ALPHA_TEST_SEED=remote-test-sharding-20260902-v1

# Complete, bounded, and explicitly remote-disabled fallback.
build:remote-disabled-local --spawn_strategy=sandboxed
build:remote-disabled-local --strategy=Genrule=sandboxed
build:remote-disabled-local --remote_cache=
build:remote-disabled-local --remote_executor=
build:remote-disabled-local --remote_upload_local_results=false
build:remote-disabled-local --guard_against_concurrent_changes=full
build:remote-disabled-local --jobs=4
build:remote-disabled-local --local_resources=cpu=4
build:remote-disabled-local --local_resources=memory=4096
test:remote-disabled-local --local_test_jobs=4
test:remote-disabled-local --flaky_test_attempts=1
test:remote-disabled-local --runs_per_test=1
test:remote-disabled-local --test_env=PYTHONHASHSEED=20260902
test:remote-disabled-local --test_env=ALPHA_TEST_SEED=remote-test-sharding-20260902-v1

# Diagnostic-only repeats; quarantined tests remain in normal shards.
test:remote-quarantine-diagnostics --config=remote-execution
test:remote-quarantine-diagnostics --runs_per_test=5
