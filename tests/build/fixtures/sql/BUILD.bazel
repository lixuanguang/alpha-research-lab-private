load("@alpha_research_pypi//:requirements.bzl", "requirement")
load("//tools/build:sql_template.bzl", "sql_template")
load(":sql_template_test.bzl", "invalid_substitution_test")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

sql_template(
    name = "build_evidence",
    src = "build_evidence.sql.tmpl",
    substitutions = {
        "@@BUILD_IDENTITY@@": "hermetic-build-fixture",
        "@@TABLE_NAME@@": "build_artifact_digest",
    },
)

py_test(
    name = "generated_sql_test",
    srcs = ["generated_sql_test.py"],
    data = [
        ":build_evidence",
        "build_evidence.expected.sql",
    ],
    main = "generated_sql_test.py",
)

py_test(
    name = "generated_sql_contract_test",
    srcs = [
        "generated_sql_test.py",
        "test_generated_sql_contracts.py",
    ],
    imports = ["."],
    main = "test_generated_sql_contracts.py",
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    deps = [requirement("pytest")],
)

sql_template(
    name = "invalid_substitution",
    src = "build_evidence.sql.tmpl",
    substitutions = {"TABLE_NAME": "invalid"},
    tags = ["manual"],
)

invalid_substitution_test(
    name = "invalid_substitution_test",
    target_under_test = ":invalid_substitution",
)
