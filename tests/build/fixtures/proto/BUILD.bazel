load("@alpha_research_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

exports_files(["buf.yaml"])

py_test(
    name = "buf_compatibility_test",
    srcs = ["buf_compatibility_test.py"],
    args = [
        "$(location @rules_buf_toolchains//:buf)",
        "$(location :buf.yaml)",
        "$(location :alpha_research/build/v1/toolchain_probe.proto)",
    ],
    data = [
        ":buf.yaml",
        "alpha_research/build/v1/toolchain_probe.proto",
        "@rules_buf_toolchains//:buf",
    ],
    main = "buf_compatibility_test.py",
)

py_test(
    name = "buf_toolchain_test",
    srcs = ["buf_toolchain_test.py"],
    args = [
        "$(location @rules_buf_toolchains//:buf)",
        "$(location :buf.yaml)",
    ],
    data = [
        ":buf.yaml",
        "alpha_research/build/v1/toolchain_probe.proto",
        "@rules_buf_toolchains//:buf",
    ],
    main = "buf_toolchain_test.py",
)

py_test(
    name = "buf_contract_test",
    srcs = [
        "buf_compatibility_test.py",
        "buf_toolchain_test.py",
        "test_buf_contracts.py",
    ],
    imports = ["."],
    main = "test_buf_contracts.py",
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    deps = [requirement("pytest")],
)
