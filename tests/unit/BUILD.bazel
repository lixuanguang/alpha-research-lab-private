load("@alpha_research_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

py_test(
    name = "instrument_identity_test",
    srcs = ["test_instrument_identity.py"],
    data = ["//tests/golden/instrument_identity:c01_symbology.json"],
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    main = "test_instrument_identity.py",
    deps = [
        "//src/alpha_research/instrument_identity",
        requirement("hypothesis"),
        requirement("pydantic"),
        requirement("pytest"),
    ],
)

py_test(
    name = "venue_calendar_test",
    srcs = ["test_venue_calendar.py"],
    data = ["//tests/golden/venue_calendar:c02_calendars.json"],
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    main = "test_venue_calendar.py",
    deps = [
        "//src/alpha_research/venue_calendar",
        requirement("exchange-calendars"),
        requirement("pandas"),
        requirement("hypothesis"),
        requirement("pydantic"),
        requirement("pytest"),
    ],
)

py_test(
    name = "financial_units_test",
    srcs = ["test_financial_units.py"],
    data = ["//tests/golden/financial_units:c03_units.json"],
    env = {"PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"},
    main = "test_financial_units.py",
    deps = [
        "//src/alpha_research/financial_units",
        "//src/alpha_research/instrument_identity",
        "//src/alpha_research/venue_calendar",
        requirement("hypothesis"),
        requirement("quantlib"),
        requirement("pydantic"),
        requirement("pytest"),
    ],
)
