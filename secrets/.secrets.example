# Venue credential files live in this gitignored directory, one per venue.
# Each file uses the shared KEY=VALUE field names below, values without quotes.
# Files must be owner-only: `chmod 600 secrets/*.secrets` (group/world access is refused).
# Loaded by `configuration.VenueSecrets.read("<venue>")`; values are wrapped so
# they never appear in repr, logs, exceptions or pickles.
#
#   secrets/alpaca.secrets      API_KEY, API_SECRET
#   secrets/coinbase.secrets    API_KEY, API_SECRET (base64), API_PASSPHRASE
#   secrets/coingecko.secrets   API_KEY
#   secrets/EIA.secrets         API_KEY
#   secrets/polymarket.secrets  API_KEY, API_SECRET

API_KEY=
API_SECRET=
