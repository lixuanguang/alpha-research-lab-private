# Local secrets file (gitignored in practice): copy to `secrets/.secrets`
# Use owner-only permissions on POSIX: `chmod 600 secrets/.secrets`
# Format: KEY=VALUE
# Resolution precedence in code: environment variable > secrets/.secrets
# Optional fallback: `secrets/<venue>.secrets` with `API_KEY_ENV` / `PRIVATE_KEY_ENV`
# (for example, `secrets/polymarket.secrets`)

# Generic keys (if your config references these names)
API_KEY_ENV=
PRIVATE_KEY_ENV=

# Venue-specific keys used by current default config
ALPHA_KALSHI_API_KEY=
ALPHA_KALSHI_PRIVATE_KEY=
ALPHA_KALSHIDEMO_API_KEY=
ALPHA_KALSHIDEMO_PRIVATE_KEY=
ALPHA_POLYMARKET_API_KEY=
ALPHA_POLYMARKET_PRIVATE_KEY=
ALPHA_LIMITLESS_API_KEY=
ALPHA_LIMITLESS_PRIVATE_KEY=
ALPHA_BAOZI_API_KEY=
ALPHA_BAOZI_PRIVATE_KEY=
ALPHA_MYRIAD_API_KEY=
ALPHA_MYRIAD_PRIVATE_KEY=
ALPHA_PROBABLE_API_KEY=
ALPHA_PROBABLE_PRIVATE_KEY=
