load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "alpha_research",
    srcs = glob(
        ["**/*.py"],
        exclude = [
            "financial_units/**/*.py",
            "instrument_identity/**/*.py",
            "venue_calendar/**/*.py",
        ],
    ),
    data = ["py.typed"],
    imports = [".."],
    deps = [
        "//src/alpha_research/financial_units",
        "//src/alpha_research/instrument_identity",
        "//src/alpha_research/venue_calendar",
        "//tools/governance/src/alpha_research_governance",
    ],
)
