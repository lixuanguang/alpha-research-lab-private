load("@alpha_research_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "alpha_research_governance",
    srcs = glob(["**/*.py"]),
    data = ["py.typed"],
    imports = [".."],
    deps = [requirement("pydantic")],
)

[
    py_binary(
        name = name,
        srcs = [main],
        main = main,
        deps = [":alpha_research_governance"],
    )
    for name, main in {
        "cmd_architecture": "architecture_governance.py",
        "cmd_artifacts": "artifact_supply_chain/__main__.py",
        "cmd_change_risk": "change_risk/__main__.py",
        "cmd_ci": "ci_policy/__main__.py",
        "cmd_dependencies": "dependency_admission/__main__.py",
        "cmd_engineering_standards": "engineering_standards/__main__.py",
        "cmd_evidence": "evidence/__main__.py",
        "cmd_inventory": "inventory/__main__.py",
        "cmd_ownership": "ownership_governance.py",
        "cmd_program": "program_governance/__main__.py",
        "cmd_remote_execution": "remote_execution/__main__.py",
        "cmd_security": "security_controls/__main__.py",
        "cmd_topology": "repository_topology/__main__.py",
    }.items()
]
