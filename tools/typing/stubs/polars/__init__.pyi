"""Narrow Polars declarations used by the bounded research adapter."""

# standard library imports
from collections.abc import Mapping, Sequence

class DataType:
    """Opaque Polars schema type."""

class Expr:
    """Opaque Polars expression used by fixed filters."""

    def eq(self, other: object) -> Expr:
        """Build an equality predicate.

        Args:
            other: Scalar compared with this expression.

        Returns:
            A lazy predicate expression.
        """
        ...

    def __ge__(self, other: object) -> Expr:
        """Build a greater-than-or-equal predicate."""
        ...

    def __lt__(self, other: object) -> Expr:
        """Build a less-than predicate."""
        ...

    def __and__(self, other: Expr) -> Expr:
        """Combine two lazy predicates."""
        ...

    def is_not_null(self) -> Expr:
        """Build a non-null predicate.

        Returns:
            A lazy non-null predicate expression.
        """
        ...

class Series:
    """Narrow series projection used to recover retained row identities."""

    def to_list(self) -> list[object]:
        """Return scalar values in series order.

        Returns:
            Python values from the selected column.
        """
        ...

class LazyFrame:
    """Narrow lazy transformation surface used by bounded analysis."""

    def filter(self, predicate: Expr) -> LazyFrame:
        """Apply one fixed predicate.

        Args:
            predicate: Bounded expression generated by the adapter.

        Returns:
            A lazy frame with the predicate applied.
        """
        ...

    def sort(self, columns: Sequence[str]) -> LazyFrame:
        """Apply stable ordering by named columns.

        Args:
            columns: Ordered sort columns.

        Returns:
            A lazy sorted frame.
        """
        ...

    def limit(self, n: int) -> LazyFrame:
        """Apply a bounded row limit.

        Args:
            n: Maximum number of rows.

        Returns:
            A lazy limited frame.
        """
        ...

    def collect(self) -> DataFrame:
        """Execute the fixed lazy transformation.

        Returns:
            A materialized typed frame.
        """
        ...

class DataFrame:
    """Narrow typed dataframe surface used by bounded analysis."""

    def __init__(
        self,
        data: Mapping[str, Sequence[object]],
        *,
        schema: Mapping[str, DataType] | None = ...,
        strict: bool = ...,
    ) -> None:
        """Construct one typed frame.

        Args:
            data: Column names and ordered values.
            schema: Declared Polars types.
            strict: Reject values that do not match the schema.
        """
        ...

    def lazy(self) -> LazyFrame:
        """Return the frame as a lazy transformation source.

        Returns:
            Lazy frame backed by this typed data.
        """
        ...

    def get_column(self, name: str) -> Series:
        """Select one named column.

        Args:
            name: Existing column name.

        Returns:
            The selected series.
        """
        ...

    def to_dict(self, *, as_series: bool = ...) -> dict[str, list[object]]:
        """Return materialized columns as Python lists.

        Args:
            as_series: Whether the real Polars API would return series; the adapter
                requests Python lists with ``False``.

        Returns:
            Ordered column values for backend conversion checks.
        """
        ...

String: DataType
Int64: DataType

def Datetime(time_unit: str = ..., time_zone: str | None = ...) -> DataType:
    """Declare a datetime column type.

    Args:
        time_unit: Datetime precision.
        time_zone: Optional timezone name.

    Returns:
        Opaque Polars datetime type.
    """
    ...

def col(name: str) -> Expr:
    """Reference one named column in a lazy expression.

    Args:
        name: Existing column name.

    Returns:
        A lazy column expression.
    """
    ...
