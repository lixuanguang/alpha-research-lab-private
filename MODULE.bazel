module(
    name = "alpha_research_lab",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_buf", version = "0.5.4")
bazel_dep(name = "rules_python", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.override(
    add_runtime_manifest_urls = [
        "https://github.com/astral-sh/python-build-standalone/releases/download/20260814/SHA256SUMS",
    ],
    runtime_manifest_sha = "0e27ff80c0075aa29730035faf2b94a00498f348131c6e8997cbbb5b77584966",
)
python.defaults(python_version = "3.12.14")
python.toolchain(
    is_default = True,
    python_version = "3.12.14",
)
use_repo(python, "python_3_12_14")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "alpha_research_pypi",
    python_version = "3.12.14",
    requirements_lock = "//:requirements.bazel.txt",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "alpha_research_pypi")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "c6ddd4f90a2829ea04efbfbbbc44f8f5d4a0f2dda3bec5ec3fbb652c2d394c06",
    version = "v1.72.0",
)
use_repo(buf, "rules_buf_toolchains")
